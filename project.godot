; TempestRPG — Godot 4.6.3 / GDScript.
config_version=5

[application]
config/name="TempestRPG"
config/version="1.6.0"
run/main_scene="res://scenes/menu/title_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="TempestRPG"

[autoload]
GameSession="*res://scripts/network/game_session.gd"
Audio="*res://scripts/audio/audio_director.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.05, 0.09, 0.1, 1)

