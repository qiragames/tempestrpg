; TempestRPG — Godot 4.6.3 / GDScript.
config_version=5

[application]
config/name="TempestRPG"
run/main_scene="res://scenes/world/forest.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]
GameSession="*res://scripts/network/game_session.gd"

[display]
window/size/viewport_width=480
window/size/viewport_height=320
window/size/window_width_override=960
window/size/window_height_override=640
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.05, 0.09, 0.1, 1)

